# Copy to .env.local for local dev, and add the same variable in Vercel → Project → Settings → Environment Variables.

# Contact form: use ONE of these.
# Web3Forms (free): get an access key at https://web3forms.com (it is meant to be public, safe in client code)
NEXT_PUBLIC_WEB3FORMS_KEY=
# Formspree: the form ID from https://formspree.io/f/<THIS_PART>
NEXT_PUBLIC_FORMSPREE_ID=

# Your live URL, used for canonical links, sitemap, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
